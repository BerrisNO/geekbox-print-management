{
  "name": "@geekbox/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --conditions=development --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "depcruise": "depcruise src --config ../../.dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/static": "10.1.2",
    "@geekbox/shared": "workspace:*",
    "argon2": "0.44.0",
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "mqtt": "5.13.1",
    "pino": "10.3.1",
    "uuid": "11.1.1",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.3",
    "drizzle-kit": "0.31.4",
    "fast-check": "4.1.1",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
