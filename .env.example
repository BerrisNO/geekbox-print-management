# GeekBOX Print Management — environment contract (impl-spec §3)
# Copy to .env and fill in. .env is gitignored and MUST NOT be committed.

# --- Required ---
# Signs/derives the session cookie material (ADR-007). Min 32 chars.
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long
# AES-256-GCM key for the Bambu TokenVault (NFR-SE-02, ADR-010).
# 32 bytes, base64 or hex encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-base64-encoded-32-byte-key============
# Runtime mode: development | production | test
NODE_ENV=production

# --- Optional (defaults shown) ---
PORT=8080
DB_PATH=/data/geekbox.sqlite
BACKUP_DIR=/data/backups
LOG_LEVEL=info
# MQTT_REGION overrides the DB integration setting when set (ADR-012). us | eu | cn | <custom hostname>
# MQTT_REGION=us
# Session cookie Secure flag. Defaults to true in production. Browsers DROP Secure
# cookies over plain HTTP, so set COOKIE_SECURE=false when serving over HTTP on a
# trusted LAN. Leave true (or unset) when behind an HTTPS/TLS reverse proxy.
# COOKIE_SECURE=false
