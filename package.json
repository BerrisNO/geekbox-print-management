{
  "name": "geekbox-print-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "depcruise": "pnpm --filter @geekbox/backend depcruise",
    "dev": "pnpm --filter @geekbox/backend dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "dependency-cruiser": "16.10.0",
    "typescript": "5.9.2"
  }
}
